@page "/"

<PageTitle>BlazorScheduler v5</PageTitle>

<main class="demo-shell">
    <header class="demo-heading">
        <div>
            <h1>BlazorScheduler</h1>
            <p>Drag across days to create an appointment, double-click a day for a same-day appointment, click an appointment to edit it, or drag it to reschedule.</p>
        </div>
        <span class="mode-pill">.NET 10 · WebAssembly</span>
    </header>

    <section class="demo-card">
        <p class="demo-status" aria-live="polite">@_status</p>

        <div class="demo-controls">
            <span class="demo-control-label">View</span>
            <button class="demo-btn @(_view == SchedulerView.Month ? "active" : null)" @onclick="() => _view = SchedulerView.Month">Month</button>
            <button class="demo-btn @(_view == SchedulerView.Week ? "active" : null)" @onclick="() => _view = SchedulerView.Week">Week</button>
            <span class="demo-control-label">Week starts on</span>
            <button class="demo-btn @(_startDay == DayOfWeek.Sunday ? "active" : null)" @onclick="() => _startDay = DayOfWeek.Sunday">Sun</button>
            <button class="demo-btn @(_startDay == DayOfWeek.Monday ? "active" : null)" @onclick="() => _startDay = DayOfWeek.Monday">Mon</button>
            <button class="demo-btn @(_startDay == DayOfWeek.Saturday ? "active" : null)" @onclick="() => _startDay = DayOfWeek.Saturday">Sat</button>
            <span class="demo-control-label">Month weeks</span>
            <button class="demo-btn @(_monthWeeks is null ? "active" : null)" @onclick="() => _monthWeeks = null">auto</button>
            <button class="demo-btn @(_monthWeeks == 6 ? "active" : null)" @onclick="() => _monthWeeks = 6">6</button>
            <span class="demo-control-label">Time</span>
            <button class="demo-btn @(_use24Hour ? "active" : null)" @onclick="() => _use24Hour = true">24h</button>
            <button class="demo-btn @(!_use24Hour ? "active" : null)" @onclick="() => _use24Hour = false">12h</button>
        </div>

        <DataScheduler TItem="CalendarItem"
                   Items="_items"
                   ItemKey="item => item.Id"
                   ItemStart="item => item.Start"
                   ItemEnd="item => item.End"
                   ItemColor="item => item.Color"
                   @bind-View="_view"
                   StartDayOfWeek="_startDay"
                   MonthViewWeeks="_monthWeeks"
                   Use24HourClock="_use24Hour"
                   EnableRescheduling="true"
                   OnCreate="CreateAsync"
                   OnItemClick="ItemClickedAsync"
                   OnDayDoubleClick="DayDoubleClickedAsync"
                   OnItemReschedule="RescheduleAsync"
                   OnOverflowClick="OverflowClickedAsync">
            <ItemTemplate Context="context">
                <strong>@context.Item.Title</strong>
            </ItemTemplate>
        </DataScheduler>
    </section>
</main>

@if (_editing is not null || _pendingRange is not null)
{
    <div class="modal-backdrop" @onclick="CancelModalAsync">
        <div class="modal" role="dialog" aria-modal="true" aria-label="@(_editing is not null ? "Edit appointment" : "New appointment")" @onclick:stopPropagation>
            <h2>@(_editing is not null ? "Edit appointment" : "New appointment")</h2>
            <p class="modal-range">@FormatRange(_modalStart, _modalEnd)</p>

            <label class="modal-field">
                <span>Title</span>
                <input type="text" @bind="_modalTitle" />
            </label>
            <label class="modal-field">
                <span>Location</span>
                <input type="text" @bind="_modalLocation" placeholder="Optional" />
            </label>
            <div class="modal-row">
                <label class="modal-field">
                    <span>Starts</span>
                    <input type="datetime-local" value="@_modalStartLocal" @onchange="OnModalStartChanged" />
                </label>
                <label class="modal-field">
                    <span>Ends</span>
                    <input type="datetime-local" value="@_modalEndLocal" @onchange="OnModalEndChanged" />
                </label>
            </div>
            <label class="modal-field">
                <span>Description</span>
                <textarea @bind="_modalDescription" placeholder="Optional"></textarea>
            </label>

            <fieldset class="modal-field modal-color">
                <legend>Color</legend>
                <div class="color-swatches">
                    @foreach (var color in _palette)
                    {
                        <button type="button"
                                class="color-swatch @(string.Equals(_modalColor, color, StringComparison.OrdinalIgnoreCase) ? "active" : null)"
                                style="--swatch:@color"
                                aria-label="Use color @color"
                                title="@color"
                                @onclick="() => _modalColor = color"></button>
                    }
                </div>
                <label class="color-custom">
                    <span>Custom</span>
                    <input type="color" value="@_modalColor" @onchange="OnModalColorChanged" />
                    <span class="color-hex">@_modalColor</span>
                </label>
            </fieldset>

            <div class="modal-actions">
                <button type="button" class="demo-btn" @onclick="CancelModalAsync">Cancel</button>
                <button type="button" class="demo-btn primary" @onclick="SaveAsync">Save</button>
            </div>
        </div>
    </div>
}

@code {
    private static readonly string[] _palette =
    {
        "#2563eb", "#0f9d78", "#e87924", "#9c5de8",
        "#dc2626", "#0891b2", "#db2777", "#64748b",
    };

    private IReadOnlyList<CalendarItem> _items = CreateSampleItems();
    private string _status = "Ready. Drag across days to create or reschedule, double-click a day for a same-day appointment, or click an appointment to edit it.";
    private SchedulerView _view = SchedulerView.Month;
    private DayOfWeek _startDay = DayOfWeek.Sunday;
    private int? _monthWeeks;
    private bool _use24Hour = true;

    private CalendarItem? _editing;
    private SchedulerRange? _pendingRange;
    private string _modalTitle = string.Empty;
    private string _modalLocation = string.Empty;
    private string _modalDescription = string.Empty;
    private string _modalStartLocal = string.Empty;
    private string _modalEndLocal = string.Empty;
    private string _modalColor = _palette[0];

    private DateTime _modalStart => _editing?.Start ?? _pendingRange?.Start ?? DateTime.Today;
    private DateTime _modalEnd => _editing?.End ?? _pendingRange?.End ?? _modalStart.AddHours(1);

    private Task CreateAsync(SchedulerRange range)
    {
        _editing = null;
        _pendingRange = range;
        _modalTitle = "New appointment";
        _modalLocation = string.Empty;
        _modalDescription = string.Empty;
        _modalColor = _palette[Random.Shared.Next(_palette.Length)];
        _modalStartLocal = ToLocalInput(range.Start);
        _modalEndLocal = ToLocalInput(range.End);
        _status = "Fill in the details and save to add the appointment.";
        return Task.CompletedTask;
    }

    private Task DayDoubleClickedAsync(SchedulerRange range) => CreateAsync(range);

    private Task ItemClickedAsync(CalendarItem item)
    {
        _editing = item;
        _pendingRange = null;
        _modalTitle = item.Title;
        _modalLocation = item.Location ?? string.Empty;
        _modalDescription = item.Description ?? string.Empty;
        _modalColor = item.Color;
        _modalStartLocal = ToLocalInput(item.Start);
        _modalEndLocal = ToLocalInput(item.End);
        _status = "Edit the appointment and save to apply your changes.";
        return Task.CompletedTask;
    }

    private void OnModalStartChanged(ChangeEventArgs args) => _modalStartLocal = args.Value?.ToString() ?? string.Empty;

    private void OnModalEndChanged(ChangeEventArgs args) => _modalEndLocal = args.Value?.ToString() ?? string.Empty;

    private void OnModalColorChanged(ChangeEventArgs args) => _modalColor = NormalizeColor(args.Value?.ToString());

    private Task SaveAsync()
    {
        if (_editing is null && _pendingRange is null)
        {
            return Task.CompletedTask;
        }

        var title = string.IsNullOrWhiteSpace(_modalTitle) ? "New appointment" : _modalTitle.Trim();
        var start = TryParseLocal(_modalStartLocal) ?? _modalStart;
        var end = TryParseLocal(_modalEndLocal) ?? _modalEnd;
        if (end <= start)
        {
            end = start.AddHours(1);
        }

        var color = NormalizeColor(_modalColor);
        var location = string.IsNullOrWhiteSpace(_modalLocation) ? null : _modalLocation.Trim();
        var description = string.IsNullOrWhiteSpace(_modalDescription) ? null : _modalDescription.Trim();

        if (_editing is CalendarItem existing)
        {
            var updated = existing with { Title = title, Start = start, End = end, Color = color, Location = location, Description = description };
            _items = _items.Select(item => item.Id == updated.Id ? updated : item).ToArray();
            _status = $"Updated {title} ({FormatRange(start, end)}).";
        }
        else
        {
            var next = new CalendarItem(Guid.NewGuid(), title, start, end, color, location, description);
            _items = _items.Append(next).ToArray();
            _status = $"Created {title} ({FormatRange(start, end)}).";
        }

        _editing = null;
        _pendingRange = null;
        return Task.CompletedTask;
    }

    private Task CancelModalAsync()
    {
        var wasEditing = _editing is not null;
        _editing = null;
        _pendingRange = null;
        _status = wasEditing ? "Appointment edit cancelled." : "Appointment creation cancelled.";
        return Task.CompletedTask;
    }

    private static string ToLocalInput(DateTime value) =>
        value.ToString("yyyy-MM-ddTHH:mm", System.Globalization.CultureInfo.InvariantCulture);

    private static string NormalizeColor(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return "#2563eb";
        }
        value = value.Trim();
        return value.StartsWith('#') ? value : $"#{value}";
    }

    private static DateTime? TryParseLocal(string value) =>
        DateTime.TryParse(value, System.Globalization.CultureInfo.InvariantCulture, System.Globalization.DateTimeStyles.None, out var parsed)
            ? parsed
            : null;

    private string FormatRange(DateTime start, DateTime end)
    {
        var format = _use24Hour ? "MMM d, yyyy HH:mm" : "MMM d, yyyy h:mm tt";
        return $"{start.ToString(format, System.Globalization.CultureInfo.CurrentCulture)} – {end.ToString(format, System.Globalization.CultureInfo.CurrentCulture)}";
    }

    private Task RescheduleAsync(SchedulerItemRescheduleEventArgs<CalendarItem> args)
    {
        _items = _items.Select(item => item.Id == args.Item.Id ? item with { Start = args.Start, End = args.End } : item).ToArray();
        _status = $"Moved {args.Item.Title} to {args.Start:d}.";
        return Task.CompletedTask;
    }

    private Task OverflowClickedAsync(SchedulerOverflowEventArgs<CalendarItem> args)
    {
        _status = $"{args.Items.Count} more appointment(s) on {args.Day:d}.";
        return Task.CompletedTask;
    }

    private static IReadOnlyList<CalendarItem> CreateSampleItems()
    {
        var today = DateTime.Today;
        return new[]
        {
            // A busy first day: stacked timed items with an overflow chip.
            new CalendarItem(Guid.NewGuid(), "Planning", today.AddHours(9), today.AddHours(10), "#2563eb"),
            new CalendarItem(Guid.NewGuid(), "Stand-up", today.AddHours(10), today.AddHours(10).AddMinutes(30), "#0f9d78"),
            new CalendarItem(Guid.NewGuid(), "Client call", today.AddHours(11), today.AddHours(12), "#e87924"),
            new CalendarItem(Guid.NewGuid(), "Lunch with team", today.AddHours(12), today.AddHours(13), "#dc2626"),
            new CalendarItem(Guid.NewGuid(), "1:1", today.AddHours(14), today.AddHours(15), "#0891b2"),
            new CalendarItem(Guid.NewGuid(), "Design review", today.AddHours(15), today.AddHours(16), "#9c5de8"),
            new CalendarItem(Guid.NewGuid(), "Sprint planning", today.AddHours(16), today.AddHours(17), "#64748b"),
            // Timed and multi-day items spread across the month.
            new CalendarItem(Guid.NewGuid(), "Product launch", today.AddDays(2), today.AddDays(4), "#0f9d78"),
            new CalendarItem(Guid.NewGuid(), "Design review", today.AddDays(7).AddHours(13), today.AddDays(7).AddHours(14), "#e87924"),
            new CalendarItem(Guid.NewGuid(), "Vacation", today.AddDays(10), today.AddDays(15), "#9c5de8"),
            new CalendarItem(Guid.NewGuid(), "Retro", today.AddDays(14).AddHours(16), today.AddDays(14).AddHours(17), "#0891b2"),
            new CalendarItem(Guid.NewGuid(), "Docs sprint", today.AddDays(21), today.AddDays(23), "#64748b"),
        };
    }

    public sealed record CalendarItem(Guid Id, string Title, DateTime Start, DateTime End, string Color,
        string? Location = null, string? Description = null);
}

@page "/"

<PageTitle>BlazorScheduler v5</PageTitle>

<main class="demo-shell">
    <header class="demo-heading">
        <div>
            <h1>BlazorScheduler</h1>
            <p>A fast, data-driven calendar for Blazor. Drag across empty days to create an appointment or drag an appointment to reschedule it.</p>
        </div>
        <span class="mode-pill">.NET 10 · WebAssembly</span>
    </header>

    <section class="demo-card">
        <p class="demo-status" aria-live="polite">@_status</p>

        <div class="demo-controls">
            <span class="demo-control-label">View</span>
            <button class="demo-btn @(_view == SchedulerView.Month ? "active" : null)" @onclick="() => _view = SchedulerView.Month">Month</button>
            <button class="demo-btn @(_view == SchedulerView.Week ? "active" : null)" @onclick="() => _view = SchedulerView.Week">Week</button>
            <span class="demo-control-label">Week starts on</span>
            <button class="demo-btn @(_startDay == DayOfWeek.Sunday ? "active" : null)" @onclick="() => _startDay = DayOfWeek.Sunday">Sun</button>
            <button class="demo-btn @(_startDay == DayOfWeek.Monday ? "active" : null)" @onclick="() => _startDay = DayOfWeek.Monday">Mon</button>
            <button class="demo-btn @(_startDay == DayOfWeek.Saturday ? "active" : null)" @onclick="() => _startDay = DayOfWeek.Saturday">Sat</button>
            <span class="demo-control-label">Month weeks</span>
            <button class="demo-btn @(_monthWeeks is null ? "active" : null)" @onclick="() => _monthWeeks = null">auto</button>
            <button class="demo-btn @(_monthWeeks == 6 ? "active" : null)" @onclick="() => _monthWeeks = 6">6</button>
            <span class="demo-control-label">Time</span>
            <button class="demo-btn @(_use24Hour ? "active" : null)" @onclick="() => _use24Hour = true">24h</button>
            <button class="demo-btn @(!_use24Hour ? "active" : null)" @onclick="() => _use24Hour = false">12h</button>
        </div>

        <DataScheduler TItem="CalendarItem"
                   Items="_items"
                   ItemKey="item => item.Id"
                   ItemStart="item => item.Start"
                   ItemEnd="item => item.End"
                   ItemColor="item => item.Color"
                   @bind-View="_view"
                   StartDayOfWeek="_startDay"
                   MonthViewWeeks="_monthWeeks"
                   Use24HourClock="_use24Hour"
                   EnableRescheduling="true"
                   OnCreate="CreateAsync"
                   OnItemClick="ItemClickedAsync"
                   OnItemReschedule="RescheduleAsync"
                   OnOverflowClick="OverflowClickedAsync">
            <ItemTemplate Context="context">
                <strong>@context.Item.Title</strong>
            </ItemTemplate>
        </DataScheduler>
    </section>
</main>

@if (_pendingRange is SchedulerRange pending)
{
    <div class="modal-backdrop" @onclick="CancelCreateAsync">
        <div class="modal" role="dialog" aria-modal="true" aria-label="New appointment" @onclick:stopPropagation>
            <h2>New appointment</h2>
            <p class="modal-range">@FormatRange(pending.Start, pending.End)</p>

            <label class="modal-field">
                <span>Title</span>
                <input type="text" @bind="_modalTitle" />
            </label>
            <label class="modal-field">
                <span>Location</span>
                <input type="text" @bind="_modalLocation" placeholder="Optional" />
            </label>
            <div class="modal-row">
                <label class="modal-field">
                    <span>Starts</span>
                    <input type="datetime-local" value="@_modalStartLocal" @onchange="OnModalStartChanged" />
                </label>
                <label class="modal-field">
                    <span>Ends</span>
                    <input type="datetime-local" value="@_modalEndLocal" @onchange="OnModalEndChanged" />
                </label>
            </div>
            <label class="modal-field">
                <span>Description</span>
                <textarea @bind="_modalDescription" placeholder="Optional"></textarea>
            </label>

            <div class="modal-actions">
                <button type="button" class="demo-btn" @onclick="CancelCreateAsync">Cancel</button>
                <button type="button" class="demo-btn primary" @onclick="SaveCreateAsync">Save</button>
            </div>
        </div>
    </div>
}

@code {
    private IReadOnlyList<CalendarItem> _items = CreateSampleItems();
    private string _status = "Ready.";
    private SchedulerView _view = SchedulerView.Month;
    private DayOfWeek _startDay = DayOfWeek.Sunday;
    private int? _monthWeeks;
    private bool _use24Hour = true;

    private SchedulerRange? _pendingRange;
    private string _modalTitle = string.Empty;
    private string _modalLocation = string.Empty;
    private string _modalDescription = string.Empty;
    private string _modalStartLocal = string.Empty;
    private string _modalEndLocal = string.Empty;

    private Task CreateAsync(SchedulerRange range)
    {
        _pendingRange = range;
        _modalTitle = "New appointment";
        _modalLocation = string.Empty;
        _modalDescription = string.Empty;
        _modalStartLocal = range.Start.ToString("yyyy-MM-ddTHH:mm", System.Globalization.CultureInfo.InvariantCulture);
        _modalEndLocal = range.End.ToString("yyyy-MM-ddTHH:mm", System.Globalization.CultureInfo.InvariantCulture);
        _status = "Fill in the details and save to add the appointment.";
        return Task.CompletedTask;
    }

    private void OnModalStartChanged(ChangeEventArgs args) => _modalStartLocal = args.Value?.ToString() ?? string.Empty;

    private void OnModalEndChanged(ChangeEventArgs args) => _modalEndLocal = args.Value?.ToString() ?? string.Empty;

    private Task SaveCreateAsync()
    {
        if (_pendingRange is not SchedulerRange range)
        {
            return Task.CompletedTask;
        }

        var title = string.IsNullOrWhiteSpace(_modalTitle) ? "New appointment" : _modalTitle.Trim();
        var start = TryParseLocal(_modalStartLocal) ?? range.Start;
        var end = TryParseLocal(_modalEndLocal) ?? range.End;
        if (end <= start)
        {
            end = start.AddHours(1);
        }

        var rnd = new Random();
        var newColor = $"#{rnd.Next(255):X2}{rnd.Next(255):X2}{rnd.Next(255):X2}";
        var next = new CalendarItem(Guid.NewGuid(), title, start, end, newColor,
            string.IsNullOrWhiteSpace(_modalLocation) ? null : _modalLocation.Trim(),
            string.IsNullOrWhiteSpace(_modalDescription) ? null : _modalDescription.Trim());
        _items = _items.Append(next).ToArray();
        _pendingRange = null;
        _status = $"Created {title} ({FormatRange(start, end)}).";
        return Task.CompletedTask;
    }

    private Task CancelCreateAsync()
    {
        _pendingRange = null;
        _status = "Appointment creation cancelled.";
        return Task.CompletedTask;
    }

    private static DateTime? TryParseLocal(string value) =>
        DateTime.TryParse(value, System.Globalization.CultureInfo.InvariantCulture, System.Globalization.DateTimeStyles.None, out var parsed)
            ? parsed
            : null;

    private string FormatRange(DateTime start, DateTime end)
    {
        var format = _use24Hour ? "MMM d, yyyy HH:mm" : "MMM d, yyyy h:mm tt";
        return $"{start.ToString(format, System.Globalization.CultureInfo.CurrentCulture)} – {end.ToString(format, System.Globalization.CultureInfo.CurrentCulture)}";
    }

    private Task RescheduleAsync(SchedulerItemRescheduleEventArgs<CalendarItem> args)
    {
        _items = _items.Select(item => item.Id == args.Item.Id ? item with { Start = args.Start, End = args.End } : item).ToArray();
        _status = $"Moved {args.Item.Title} to {args.Start:d}.";
        return Task.CompletedTask;
    }

    private Task ItemClickedAsync(CalendarItem item)
    {
        _status = $"Selected {item.Title}.";
        return Task.CompletedTask;
    }

    private Task OverflowClickedAsync(SchedulerOverflowEventArgs<CalendarItem> args)
    {
        _status = $"{args.Items.Count} more appointment(s) on {args.Day:d}.";
        return Task.CompletedTask;
    }


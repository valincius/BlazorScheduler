@namespace BlazorScheduler
@typeparam TItem
@using System.Globalization
@using Microsoft.AspNetCore.Components.Web

<div class="scheduler" @ref="_root" style="--theme-color:@ThemeColor;--new-appointment-color:@NewAppointmentColor;">
    <div class="header">
        @if (HeaderTemplate is not null)
        {
            @HeaderTemplate
        }
        else
        {
            <div class="actions">
                <div class="actions-left">
                    <button type="button" class="btn today" @onclick="GoToTodayAsync">@TodayButtonText</button>
                    <div class="navigation">
                        <button type="button" class="btn icon-btn" aria-label="@PreviousLabel" @onclick="PreviousAsync">
                            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M24 0v24H0V0h24z" fill="none"/><path d="M14 7l-5 5 5 5V7z"/></svg>
                        </button>
                        <span class="selected-month" aria-live="polite">@DisplayText</span>
                        <button type="button" class="btn icon-btn" aria-label="@NextLabel" @onclick="NextAsync">
                            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M0 0h24v24H0V0z" fill="none"/><path d="M10 17l5-5-5-5v10z"/></svg>
                        </button>
                    </div>
                </div>
                <div class="actions-right">
                    @if (_loading)
                    {
                        <div class="scheduler-loader" role="status" aria-label="Loading"></div>
                    }
                    @if (ShowViewSwitcher)
                    {
                        <label class="view-switcher">
                            <span class="view-switcher-label">View</span>
                            <select class="view-select" aria-label="Calendar view" value="@View" @onchange="OnViewSelectChanged">
                                <option value="@SchedulerView.Month">Month</option>
                                <option value="@SchedulerView.Week">Week</option>
                            </select>
                        </label>
                    }
                </div>
            </div>
        }
    </div>
    @if (View == SchedulerView.Week)
    {
        <SchedulerWeekView TItem="TItem"
            Items="Items"
            ItemKey="ItemKey"
            ItemStart="ItemStart"
            ItemEnd="ItemEnd"
            ItemColor="ItemColor"
            ItemClass="ItemClass"
            ItemStyle="ItemStyle"
            Range="CurrentRange"
            MaxVisibleAppointmentsPerDay="MaxVisibleAppointmentsPerDay"
            WeekViewStartHour="WeekViewStartHour"
            WeekViewEndHour="WeekViewEndHour"
            WeekViewHourHeight="WeekViewHourHeight"
            Use24HourClock="Use24HourClock"
            DraggedIndex="_draggedIndex"
            DragStart="_dragStart"
            DragEnd="_dragEnd"
            NewAppointmentText="@NewAppointmentText"
            PlusOthersText="@PlusOthersText"
            ItemTemplate="ItemTemplate"
            WeekDayHeaderTemplate="WeekDayHeaderTemplate"
            ThemeColor="@ThemeColor"
            OnItemClick="WeekItemClickedAsync"
            OnOverflowClick="WeekOverflowClickedAsync" />
    }
    else
    {
        <SchedulerMonthView TItem="TItem"
            Items="Items"
            ItemKey="ItemKey"
            ItemStart="ItemStart"
            ItemEnd="ItemEnd"
            ItemColor="ItemColor"
            ItemClass="ItemClass"
            ItemStyle="ItemStyle"
            Range="CurrentRange"
            CurrentDate="CurrentDate"
            MaxVisibleAppointmentsPerDay="MaxVisibleAppointmentsPerDay"
            StartDayOfWeek="StartDayOfWeek"
            DraggedIndex="_draggedIndex"
            DragStart="_dragStart"
            DragEnd="_dragEnd"
            NewAppointmentText="@NewAppointmentText"
            PlusOthersText="@PlusOthersText"
            RootDaysGroupInWeekStyle="@RootDaysGroupInWeekStyle"
            RootAppointmentOverflowStyle="@RootAppointmentOverflowStyle"
            RootDayClass="@RootDayClass"
            RootDayStyle="@RootDayStyle"
            DayTemplate="DayTemplate"
            ItemTemplate="ItemTemplate"
            ThemeColor="@ThemeColor"
            OnItemClick="ItemClickedAsync"
            OnOverflowClick="MonthOverflowClickedAsync" />
    }
</div>
